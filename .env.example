# Copy to .env and fill in. Never commit .env.

# PostgreSQL (matches compose.yaml)
DATABASE_URL=postgres://lnb:lnb@localhost:5432/lnb

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Microsoft Entra app registration (multiple organizations), see docs/authentication.md
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Tenant IDs allowed to sign in, comma-separated: Epitech, e-artsup, ISEG
AUTH_ALLOWED_TENANTS=901cb4ca-b862-4029-9306-e5cd0f6d9f86,791f2edf-38ab-4c6c-b323-ea94dd988fde,8dab9574-4b8e-4eec-8e5e-791d6835fdea
