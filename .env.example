# Copy to .env and fill in. Never commit .env.

# PostgreSQL (matches compose.yaml)
DATABASE_URL=postgres://lnb:lnb@localhost:5432/lnb

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Microsoft Entra app registration (multiple organizations), see docs/authentication.md
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Tenant IDs allowed to sign in, comma-separated: Epitech, e-artsup, ISEG
AUTH_ALLOWED_TENANTS=901cb4ca-b862-4029-9306-e5cd0f6d9f86,791f2edf-38ab-4c6c-b323-ea94dd988fde,8dab9574-4b8e-4eec-8e5e-791d6835fdea

# Warden (Minecraft), see docs/warden.md. Generate the secret with: openssl rand -base64 32
WARDEN_SERVER_SECRET=
WARDEN_SERVER_HOST=mc.bde-teknantes.fr

# Mod list, see docs/mods.md. Without a CurseForge key, mod search is Modrinth only.
CURSEFORGE_API_KEY=
# MODRINTH_USER_AGENT=Charles-Mahoudeau/lnb-website (https://github.com/Charles-Mahoudeau/lnb-website)

# Events, see docs/events.md. Without a SteamGridDB key, the image picker offers uploads and links only.
STEAMGRIDDB_API_KEY=
# Push notifications, see docs/push.md. Generate the pair once with: npx web-push generate-vapid-keys
# Without all three, push is off. Keep the same keys: changing them cuts every device off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# From the BDE office, to push events to bde-teknantes.fr. Without it, the form's BDE switch is off.
BDE_API_TOKEN=
# The BDE API. Point it at a local stub to test pushes without touching the real site.
BDE_API_URL=https://bde-teknantes.fr/api/v1
